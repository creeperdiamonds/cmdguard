{
  "schemaVersion": 1,
  "id": "cmdguard",
  "version": "${version}",
  "name": "CmdGuard",
  "description": "Client-side outbound command guard. Commands your client handles locally stay local; anything else is blocked unless you allowlist it. Also reports which of your installed mods can receive messages from a server.",
  "authors": ["Creeperdiamonds Studios"],
  "contact": {
    "sources": "https://github.com/creeperdiamonds/cmdguard",
    "issues": "https://github.com/creeperdiamonds/cmdguard/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["studios.creeperdiamonds.cmdguard.CmdGuardClient"],
    "modmenu": ["studios.creeperdiamonds.cmdguard.ModMenuIntegration"]
  },
  "mixins": [
    {
      "config": "cmdguard.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "0.141.6+1.21.11"
  },
  "suggests": {
    "modmenu": "*"
  }
}
